# GS AUTOBILAN — Docker environment (copy to .env.docker)
# Used by: docker compose --env-file .env.docker up -d --build
# S088: migrate, seed, and verify site + admin in containers.

APP_NAME="GS AUTOBILAN"
APP_ENV=local
# APP_KEY=   # generate: docker compose exec app php artisan key:generate --show
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Douala

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gs_autobilan
DB_USERNAME=gs_autobilan
DB_PASSWORD=gs_autobilan_docker

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@gsautobilan.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Compose / MySQL container (also referenced in docker-compose.yml)
MYSQL_ROOT_PASSWORD=root_docker_secret

# Host port mappings (optional overrides)
DOCKER_HTTP_PORT=8080
DOCKER_MYSQL_PORT=3307
DOCKER_REDIS_PORT=6379
DOCKER_UID=1000
DOCKER_GID=1000
